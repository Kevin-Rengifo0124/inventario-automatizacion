      "parameters": {
        "jsCode": "\nconst body = $json.body ?? {};\nconst errores = [];\n\nif (body.accion !== 'revisar_stock') {\n  errores.push(\n    'El campo accion debe ser revisar_stock'\n  );\n}\n\nif (\n  typeof body.solicitud_id !== 'string' ||\n  body.solicitud_id.trim() === ''\n) {\n  errores.push(\n    'Falta el campo obligatorio solicitud_id'\n  );\n}\n\nreturn [\n  {\n    json: {\n      valido: errores.length === 0,\n      errores,\n      accion: body.accion ?? null,\n      solicitud_id:\n        typeof body.solicitud_id === 'string'\n          ? body.solicitud_id.trim()\n          : null\n    }\n  }\n];\n"
